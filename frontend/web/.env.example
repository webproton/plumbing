# Адрес Django для серверных запросов (в docker — http://app:8000)
API_INTERNAL_URL=http://localhost:8000
# Секрет для подписи cookie сессии (обязателен в production, длинная случайная строка)
SESSION_SECRET=change-me
# Название магазина в шапке и заголовках
SITE_NAME=LUXORA
# Публичный адрес сайта (canonical/og-ссылки)
PUBLIC_URL=http://localhost:3000
