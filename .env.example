# --- Django ---
SECRET_KEY=change-me
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
# True только когда Django стоит за нашим nginx (берём IP из X-Real-IP)
TRUSTED_PROXY=False
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_DB=plumbingrestapi
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://localhost:6379/1
# Очередь фоновых задач (Celery) — отдельная БД Redis
CELERY_BROKER_URL=redis://localhost:6379/2
# True — выполнять фоновые задачи сразу, без воркера (только для разработки)
CELERY_TASK_ALWAYS_EAGER=False
# Ключ шифрования паролей к сайтам поставщиков (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# Пусто — выводится из SECRET_KEY
CREDENTIALS_KEY=

# --- Email ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# --- Telegram (уведомления менеджерам) ---
TOKEN_BOT=
# chat_id менеджеров через запятую
MANAGERS=

# --- Разбор накладных через ИИ (Claude) — запасной вариант ---
# off — выключен; manual — кнопка «Розібрати через ШІ»; auto — ещё и сам, если накладная не разобралась
INVOICE_AI_MODE=off
ANTHROPIC_API_KEY=
# модель: claude-opus-5-5 (точнее) или claude-sonnet-5-5 (дешевле)
INVOICE_AI_MODEL=claude-opus-5-5

# --- Нова Пошта ---
# Поиск отделений, стоимость и отслеживание работают без ключа. Ключ нужен, чтобы создавать ТТН из кабинета:
# my.novaposhta.ua → Налаштування → Безпека → API-ключ. Город/отделение/телефон отправителя — в кабинете магазина.
NOVA_POSHTA_API_KEY=

# --- Frontend (SSR) ---
# Секрет подписи cookie сессии магазина: длинная случайная строка (openssl rand -hex 32)
SESSION_SECRET=
SITE_NAME=LUXORA
# Адрес сайта для поисковиков: canonical, sitemap.xml, ссылки в письмах — точно как в браузере (https, без / в конце)
PUBLIC_URL=https://example.com
# true — тестовый/промежуточный сервер: закрыть весь сайт от поисковиков
SEO_NOINDEX=false
# Порт nginx на хосте
HTTP_PORT=80
# true — только если сайт пока работает без HTTPS
INSECURE_COOKIES=false
